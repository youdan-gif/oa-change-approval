# === 环境变量配置 ===
# 复制本文件为 .env 并填写实际值

# Supabase PostgreSQL 连接字符串
# 在 Supabase 控制台 → Project Settings → Database → Connection string → URI
# 格式: postgresql://postgres.xxxx:密码@db.xxxx.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# 启用SSL（Supabase需要）
DATABASE_SSL=true

# JWT密钥（随机字符串，用于Token签发）
JWT_SECRET=your-random-jwt-secret-here

# 服务端口（Render自动注入，本地默认3000）
PORT=3000

# Node环境
NODE_ENV=production
